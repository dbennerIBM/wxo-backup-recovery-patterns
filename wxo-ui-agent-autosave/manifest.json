{
  "manifest_version": 3,
  "name": "wxO Agent Builder Autosave",
  "version": "0.1.0",
  "description": "Passively captures watsonx Orchestrate Agent Builder state and autosaves versioned snapshots via a local proxy.",

  "permissions": [
    "storage",
    "tabs",
    "webRequest"
  ],

  "host_permissions": [
    "*://*.watson-orchestrate.cloud.ibm.com/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.watson-orchestrate.cloud.ibm.com/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "wxO Autosave"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
