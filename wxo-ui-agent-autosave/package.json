{
  "name": "wxo-autosave-extension",
  "version": "0.1.0",
  "description": "Chrome/Edge MV3 extension — passive autosave for watsonx Orchestrate Agent Builder",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\""
  },
  "devDependencies": {
    "@samrum/vite-plugin-web-extension": "^4.0.1",
    "@types/chrome": "^0.0.268",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
