# wxo-autosave-proxy — local configuration template.
# Copy to `.env` (git-ignored) and fill in values, or export these in your shell.
# `npm start` loads .env automatically via `node --env-file-if-exists=.env`.

PORT=7878
STORAGE_PROVIDER=cos           # cos | s3 | gcs   (gdrive → 501 until implemented)
BUCKET=my-snapshot-bucket

# ── IBM Cloud Object Storage (STORAGE_PROVIDER=cos) — HMAC credentials ────────
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=
# COS_INSTANCE_CRN is accepted for backward compatibility but no longer used:
# HMAC auth does not need the ibm-service-instance-id header.
# COS_INSTANCE_CRN=

# ── AWS S3 (STORAGE_PROVIDER=s3) ──────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=

# ── GCS S3-interop (STORAGE_PROVIDER=gcs) ─────────────────────────────────────
# GCS_ACCESS_KEY_ID=
# GCS_SECRET_ACCESS_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lock to one extension install: chrome-extension://<32-char-id>
# ALLOWED_ORIGIN=chrome-extension://
